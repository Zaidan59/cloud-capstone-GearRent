{
  "realm": "capstone",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "operator"
      },
      {
        "name": "admin"
      }
    ]
  },
  "groups": [
    {
      "name": "tenant-a"
    },
    {
      "name": "tenant-b"
    }
  ],
  "clients": [
    {
      "clientId": "capstone-app",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://capstone.localhost:8088/*",
        "http://127.0.0.1:8088/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://capstone.localhost:8088",
        "http://127.0.0.1:8088"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "usera",
      "enabled": true,
