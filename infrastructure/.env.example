# Classroom-only defaults. Do not reuse outside the lab.
COMPOSE_PROJECT_NAME=cloud-capstone

GITEA_VERSION=28.2.0
GITEA_ADMIN_USER=capstone-admin
GITEA_ADMIN_PASSWORD=capstone-admin
GITEA_ADMIN_EMAIL=capstone-admin@example.local
GITEA_STUDENT_USER=student
GITEA_STUDENT_PASSWORD=student
GITEA_STUDENT_EMAIL=student@example.local

RUNNER_VERSION=5.1.1
RUNNER_NAME=capstone-local-runner

POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone
POSTGRES_PORT=5432

KEYCLOAK_VERSION=26.8.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

REGISTRY_PORT=5001

PROMETHEUS_VERSION=3.15.1
PROMETHEUS_PORT=9090
GRAFANA_VERSION=13.2.4
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

TRIVY_VERSION=0.76.0
ARGOCD_VERSION=3.5.6

K3D_CLUSTER_NAME=capstone
K3D_HTTP_PORT=8088
K3D_HTTPS_PORT=8443
